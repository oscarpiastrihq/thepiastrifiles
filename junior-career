.note{border-left:2px solid var(--orange);background:#17191a;padding:13px 16px;color:#c5c6c7;font-size:12px;margin:18px 0}
.source-list{display:flex;gap:12px;flex-wrap:wrap;margin-top:12px}
footer{border-top:1px solid var(--line);margin-top:55px;padding-top:20px;color:var(--muted);font-size:11px}
